{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moydeklarant-telegram-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-10-18",
  "workers_dev": true,
  "ratelimits": [
    {
      "name": "IP_RATE_LIMIT",
      "namespace_id": "863294817",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ]
}
